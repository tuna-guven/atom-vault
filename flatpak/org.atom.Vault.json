{
    "app-id": "org.atom.Vault",
    "runtime": "org.gnome.Platform",
    "runtime-version": "46",
    "sdk": "org.gnome.Sdk",
    "command": "atom",
    "finish-args": [
        "--share=ipc", "--socket=wayland", "--socket=fallback-x11",
        "--filesystem=home", "--device=dri"
    ],
    "modules": [
        {
            "name": "atom-vault",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release",
                "install -D atom/target/release/atom /app/bin/atom"
            ],
            "sources": [
                { "type": "dir", "path": ".." }
            ]
        }
    ]
}
