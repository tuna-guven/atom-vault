{
    "id": "io.atom_vault.AtomVault",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "atom",

    "finish-args": [
        "--share=ipc",

        "--socket=wayland",
        "--socket=fallback-x11",

        "--device=dri",

        "--share=network",

        "--persist=.atom_vault",

        "--talk-name=org.freedesktop.portal.FileChooser",
        "--talk-name=org.freedesktop.portal.Documents",
        "--talk-name=org.freedesktop.portal.OpenURI"
    ],

    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_HOME": "/run/build/atom-vault/cargo",
            "CARGO_NET_OFFLINE": "false",
            "RUSTFLAGS": "-C link-arg=-Wl,-z,relro,-z,now"
        },
        "no-debuginfo": false
    },

    "modules": [
        {
            "name": "atom-vault",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --manifest-path atom/Cargo.toml",
                "install -Dm755 target/release/atom /app/bin/atom",
                "install -Dm644 io.atom_vault.AtomVault.desktop /app/share/applications/io.atom_vault.AtomVault.desktop",
                "install -Dm644 io.atom_vault.AtomVault.metainfo.xml /app/share/metainfo/io.atom_vault.AtomVault.metainfo.xml",
                "install -Dm644 io.atom_vault.AtomVault.svg /app/share/icons/hicolor/scalable/apps/io.atom_vault.AtomVault.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
